# Host nginx endpoint for the intentionally vulnerable Nexolab application.
# Docker exposes Apache only on 127.0.0.1:8082; this is the sole public proxy.
server {
    listen 80;
    listen [::]:80;
    server_name nexolab.guajilodev.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name nexolab.guajilodev.com;

    ssl_certificate /etc/letsencrypt/live/nexolab.guajilodev.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nexolab.guajilodev.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
