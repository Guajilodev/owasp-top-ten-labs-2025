[Unit]
Description=Nexolab Docker containment firewall
After=docker.service
Requires=docker.service
StartLimitIntervalSec=0
OnFailure=nexolab-containment-failure@%n.service

[Service]
Type=exec
# The watcher is allowed to wait for bridges. nexolab-start.service creates
# stopped containers and synchronously runs apply + verify before any start.
# Applying here would make a first boot fail because the lab bridges do not yet
# exist.
ExecStart=/usr/local/sbin/nexolab-firewall watch
ExecReload=/usr/local/sbin/nexolab-firewall apply
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
