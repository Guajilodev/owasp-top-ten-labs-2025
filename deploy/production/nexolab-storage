#!/usr/bin/env bash
# Configure the bounded, dedicated filesystem used by the production DB volume.

set -euo pipefail

readonly CONFIG_DIR="/etc/nexolab"
readonly CONFIG_FILE="${CONFIG_DIR}/storage.env"
readonly DROP_IN_DIR="/etc/systemd/system/nexolab-db.slice.d"
readonly DROP_IN_FILE="${DROP_IN_DIR}/storage.conf"

report_failure() {
  if [ -x /usr/local/sbin/nexolab-report-failure ]; then
    /usr/local/sbin/nexolab-report-failure storage "$*" || true
  fi
}
fail() { report_failure "$*"; printf 'ERROR: %s\n' "$*" >&2; exit 1; }

require_root() {
  [ "${EUID}" -eq 0 ] || fail 'Run this production provisioning command as root.'
}

require_positive_integer() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]] || fail "Expected a positive integer, got '$1'."
}

validate_mount() {
  local storage_path="$1" max_mib="$2" io_device="${3:-}" target root_target capacity_bytes max_bytes mount_device_id configured_device_id

  storage_path="$(realpath -e "$storage_path")"
  [ -d "$storage_path" ] || fail "Storage path is not a directory: $storage_path"
  mountpoint -q "$storage_path" || fail "Storage path must itself be a mounted dedicated filesystem: $storage_path"

  target="$(findmnt -n -o TARGET --target "$storage_path")"
  root_target="$(findmnt -n -o TARGET --target /)"
  [ "$target" = "$storage_path" ] || fail "Storage path resolves to mount $target, not its own mountpoint."
  [ "$target" != "$root_target" ] || fail 'The database storage mount must not be the host root filesystem.'

  if [ -n "$io_device" ]; then
    mount_device_id="$(findmnt -n -o MAJ:MIN --target "$storage_path")"
    configured_device_id="$(lsblk -dn -o MAJ:MIN "$io_device")"
    [ "$mount_device_id" = "$configured_device_id" ] || \
      fail "Configured I/O device $io_device ($configured_device_id) does not back $storage_path ($mount_device_id)."
  fi

  capacity_bytes="$(df -B1 --output=size "$storage_path" | tail -n +2 | tr -d '[:space:]')"
  max_bytes=$((max_mib * 1024 * 1024))
  [ "$capacity_bytes" -le "$max_bytes" ] || fail "Mounted filesystem is ${capacity_bytes} bytes; it exceeds the approved ${max_mib} MiB bound."
}

write_configuration() {
  local storage_path="$1" io_device="$2" max_mib="$3" write_mib_per_sec="$4"

  install -d -m 0750 "$CONFIG_DIR" "$DROP_IN_DIR"
  umask 027
  cat >"$CONFIG_FILE" <<EOF
# Generated by nexolab-storage. Do not hand-edit while the service is active.
NEXOLAB_DB_STORAGE_PATH=${storage_path}
NEXOLAB_DB_STORAGE_MAX_MIB=${max_mib}
NEXOLAB_DB_IO_DEVICE=${io_device}
NEXOLAB_DB_WRITE_MIB_PER_SEC=${write_mib_per_sec}
EOF
  cat >"$DROP_IN_FILE" <<EOF
[Slice]
# MariaDB is the only workload assigned to this slice.
IOReadBandwidthMax=${io_device} ${write_mib_per_sec}M
IOWriteBandwidthMax=${io_device} ${write_mib_per_sec}M
EOF
  chmod 0640 "$CONFIG_FILE" "$DROP_IN_FILE"
  systemctl daemon-reload
  systemctl start nexolab.slice nexolab-web.slice nexolab-db.slice
}

configure() {
  [ "$#" -eq 4 ] || fail "Usage: $0 configure <mounted-storage-path> <block-device> <max-mib> <max-write-mib-per-sec>"
  local storage_path="$1" io_device="$2" max_mib="$3" write_mib_per_sec="$4"
  require_root
  require_positive_integer "$max_mib"
  require_positive_integer "$write_mib_per_sec"
  [ -b "$io_device" ] || fail "I/O device is not a block device: $io_device"
  validate_mount "$storage_path" "$max_mib" "$io_device"
  write_configuration "$(realpath -e "$storage_path")" "$io_device" "$max_mib" "$write_mib_per_sec"
  printf 'Configured bounded DB storage at %s (<= %s MiB, %s MiB/s on %s).\n' \
    "$(realpath -e "$storage_path")" "$max_mib" "$write_mib_per_sec" "$io_device"
}

verify() {
  require_root
  [ -r "$CONFIG_FILE" ] || fail "Storage configuration is missing: $CONFIG_FILE"
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
  require_positive_integer "$NEXOLAB_DB_STORAGE_MAX_MIB"
  require_positive_integer "$NEXOLAB_DB_WRITE_MIB_PER_SEC"
  [ -b "$NEXOLAB_DB_IO_DEVICE" ] || fail "Configured I/O device is unavailable: $NEXOLAB_DB_IO_DEVICE"
  validate_mount "$NEXOLAB_DB_STORAGE_PATH" "$NEXOLAB_DB_STORAGE_MAX_MIB" "$NEXOLAB_DB_IO_DEVICE"
  grep -Fqx "IOWriteBandwidthMax=${NEXOLAB_DB_IO_DEVICE} ${NEXOLAB_DB_WRITE_MIB_PER_SEC}M" "$DROP_IN_FILE" || \
    fail 'The DB slice I/O write limit is missing or inconsistent.'
  grep -Fqx "IOReadBandwidthMax=${NEXOLAB_DB_IO_DEVICE} ${NEXOLAB_DB_WRITE_MIB_PER_SEC}M" "$DROP_IN_FILE" || \
    fail 'The DB slice I/O read limit is missing or inconsistent.'
  local device_id rate_bytes io_line cgroup_parent io_path
  device_id="$(lsblk -dn -o MAJ:MIN "$NEXOLAB_DB_IO_DEVICE")"
  rate_bytes=$((NEXOLAB_DB_WRITE_MIB_PER_SEC * 1024 * 1024))
  # The DB slice may be nested under the parent nexolab.slice (PartOf=).
  # Discover the actual cgroup path from a running container in the slice.
  cgroup_parent="$(systemctl show nexolab-db.slice --property='ControlGroup' | cut -d= -f2)"
  cgroup_parent="${cgroup_parent#/sys/fs/cgroup}"
  [ -n "$cgroup_parent" ] || cgroup_parent="/"
  io_path="/sys/fs/cgroup${cgroup_parent}/io.max"
  [ -r "$io_path" ] || fail "Cannot read DB-slice io.max at $io_path."
  io_line="$(grep -F "${device_id} " "$io_path" || true)"
  [[ "$io_line" == *"rbps=${rate_bytes}"* && "$io_line" == *"wbps=${rate_bytes}"* ]] || \
    fail 'The effective DB-slice I/O limit is missing from cgroup io.max.'
  printf 'Bounded DB storage configuration verification passed.\n'
}

case "${1:-}" in
  configure) shift; configure "$@" ;;
  verify) [ "$#" -eq 1 ] || fail "Usage: $0 verify"; verify ;;
  *) printf 'Usage: %s {configure <mounted-storage-path> <block-device> <max-mib> <max-write-mib-per-sec>|verify}\n' "$0" >&2; exit 2 ;;
esac
