#!/usr/bin/env bash
# Create stopped containers, prove containment, then activate the lab.
set -euo pipefail

# The deployment declares where it lives; this repository must not. Every entry
# point -- systemd, cron, and an operator running a recovery tool by hand --
# resolves the same deployment from one root-owned file instead of repeating the
# path in a Compose env file, a cron header, and a unit drop-in. An inherited
# variable is an explicit override and still wins. This runs before the failure
# reporter exists, so it reports config errors directly.
readonly DEPLOYMENT_ENV="${NEXOLAB_DEPLOYMENT_ENV:-/etc/nexolab/deployment.env}"
deployment_fail() { printf 'ERROR: %s: %s\n' "$*" "$DEPLOYMENT_ENV" >&2; exit 1; }
load_deployment_env() {
  local line key mode
  [ -e "$DEPLOYMENT_ENV" ] || return 0
  { [ -f "$DEPLOYMENT_ENV" ] && [ ! -L "$DEPLOYMENT_ENV" ]; } || deployment_fail 'Deployment file is not a regular file'
  [ "$(stat -c '%u' "$DEPLOYMENT_ENV")" = 0 ] || deployment_fail 'Deployment file must be owned by root'
  mode="$(stat -c '%a' "$DEPLOYMENT_ENV")"
  (( (8#$mode & 0022) == 0 )) || deployment_fail 'Deployment file must not be writable by group or other'
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|'#'*) continue ;;
      NEXOLAB_PROJECT_DIR=*|NEXOLAB_PROJECT=*|NEXOLAB_WEB_CONTAINER=*|NEXOLAB_DB_CONTAINER=*|NEXOLAB_DB_VOLUME_NAME=*)
        key="${line%%=*}"; [ -n "${!key:-}" ] || export "$key=${line#*=}" ;;
      *) deployment_fail 'Deployment file contains an unsupported or malformed entry' ;;
    esac
  done <"$DEPLOYMENT_ENV"
}
load_deployment_env
readonly PROJECT_DIR="${NEXOLAB_PROJECT_DIR:?NEXOLAB_PROJECT_DIR must name the deployment checkout; declare it in the deployment file or the environment}"
readonly COMPOSE_FILE="${NEXOLAB_COMPOSE_FILE:-${PROJECT_DIR}/docker-compose.prod.yml}"
readonly FIREWALL_BIN="${NEXOLAB_FIREWALL_BIN:-/usr/local/sbin/nexolab-firewall}"
readonly NGINX_UPSTREAM_BIN="${NEXOLAB_NGINX_UPSTREAM_BIN:-/usr/local/sbin/nexolab-nginx-upstream}"
readonly RUNTIME_VERIFY_BIN="${NEXOLAB_RUNTIME_VERIFY_BIN:-/usr/local/sbin/nexolab-runtime-verify}"
readonly PROJECT="${NEXOLAB_PROJECT:-owasp2025}"
readonly WEB_CONTAINER="${NEXOLAB_WEB_CONTAINER:-${PROJECT}-web-1}"
readonly DB_CONTAINER="${NEXOLAB_DB_CONTAINER:-${PROJECT}-db-1}"
readonly LOCK_FILE="${NEXOLAB_LIFECYCLE_LOCK_FILE:-/run/nexolab-lifecycle.lock}"
readonly LOCK_TIMEOUT_SECONDS="${NEXOLAB_LIFECYCLE_LOCK_TIMEOUT_SECONDS:-30}"

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
[ "${EUID}" -eq 0 ] || fail 'Start must run as root.'
[ -f "$COMPOSE_FILE" ] || fail "Production Compose file is missing: $COMPOSE_FILE"
cd "$PROJECT_DIR"
compose() { docker compose -f "$COMPOSE_FILE" --project-directory "$PROJECT_DIR" "$@"; }

stop_and_confirm() {
  local service="$1" container="$2" state
  if ! state="$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null)"; then return 0; fi
  [ "$state" = false ] && return 0
  if ! compose stop "$service"; then
    printf 'ERROR: Compose could not stop %s; attempting direct Docker stop.\n' "$service" >&2
    docker stop --time 10 "$container" || return 1
  fi
  state="$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null)" || return 1
  [ "$state" = false ]
}

_services_may_be_running=false
_start_verified=false
cleanup_failed_start() {
  local status="$?" cleanup_failed=false
  trap - EXIT
  if [ "$_services_may_be_running" = true ] && [ "$_start_verified" != true ]; then
    stop_and_confirm web "$WEB_CONTAINER" || cleanup_failed=true
    stop_and_confirm db "$DB_CONTAINER" || cleanup_failed=true
    "$NGINX_UPSTREAM_BIN" quarantine || printf 'ERROR: Failed to restore nginx quarantine.\n' >&2
  fi
  [ "$cleanup_failed" = false ] || exit 1
  exit "$status"
}

start() {
  flock -w "$LOCK_TIMEOUT_SECONDS" 9 || fail 'Another lifecycle operation is active; lock wait expired.'
  trap cleanup_failed_start EXIT
  _services_may_be_running=true
  stop_and_confirm web "$WEB_CONTAINER" || fail 'Could not stop and confirm pre-existing web.'
  stop_and_confirm db "$DB_CONTAINER" || fail 'Could not stop and confirm pre-existing DB.'
  compose up --no-start --build
  "$FIREWALL_BIN" apply; "$FIREWALL_BIN" verify
  "$RUNTIME_VERIFY_BIN" pre-start
  "$NGINX_UPSTREAM_BIN" quarantine
  compose start db web
  "$RUNTIME_VERIFY_BIN" post-start all
  "$NGINX_UPSTREAM_BIN" refresh
  "$NGINX_UPSTREAM_BIN" verify
  _start_verified=true
}
start 9>"$LOCK_FILE"
