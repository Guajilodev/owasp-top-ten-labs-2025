# MariaDB config - OWASP Top 10 Labs 2025
# Configuracion basica para el lab

[mysqld]
# Charset UTF-8 para nombres chilenos con acentos
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Log de queries lentas (util para debug, no para prod real)
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2

# Tamano de buffer razonable para un lab
innodb_buffer_pool_size = 128M

# No necesitamos binlog para un lab educativo
skip-log-bin

[client]
default-character-set = utf8mb4
