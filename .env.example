# OWASP Top 10 Labs 2025 - Nexo
# Copia este archivo a .env y cambia los valores
#
# IMPORTANTE: Los valores por defecto son VULNERABLES INTENCIONALMENTE
# para el lab A02 (Security Misconfiguration). En produccion real,
# NUNCA uses credenciales como estas.

# ============================================
# Base de datos MariaDB
# ============================================
NEXO_DB_HOST=db
NEXO_DB_NAME=nexo_labs
NEXO_DB_USER=nexo_user
NEXO_DB_PASS=nexo_password_2025

# Root password (solo para setup inicial)
NEXO_DB_ROOT_PASS=nexo_root_secret

# Production only: exact mountpoint of the small dedicated database filesystem.
# Provision and verify it with deploy/production/nexolab-storage before using
# docker-compose.prod.yml. It must never point at / or a root-backed directory.
NEXOLAB_DB_STORAGE_PATH=/srv/nexolab-db

# ============================================
# Entorno
# ============================================
# development | production
NEXO_ENV=production

# ============================================
# Dominio (para Nginx y Certbot)
# ============================================
NEXO_DOMAIN=nexo.tudominio.com

# ============================================
# HMAC Secret (para lab A08 - version segura)
# ============================================
# Genera uno con: openssl rand -hex 32
NEXO_HMAC_SECRET=change_this_to_a_random_32_byte_hex_string

# ============================================
# Certbot / Let's Encrypt
# ============================================
CERTBOT_EMAIL=tu@email.com
