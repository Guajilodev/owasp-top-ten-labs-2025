# Legacy repository copy of the production reset schedule.
# Install deploy/production/nexolab-reset.cron instead; it is the authoritative
# production artifact and invokes the bounded root-authority recovery script.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Drop/recreate the full lab schema, restore init.sql seed data, and clean
# writable lab paths. The script has a bounded lock wait and execution limit.
0 */4 * * * root /usr/local/sbin/nexolab-reset reset >> /var/log/nexolab-reset.log 2>&1

# Host nginx owns TLS in the production topology.
0 3 * * 1 root certbot renew --quiet && systemctl reload nginx >> /var/log/nexolab-reset.log 2>&1
